{
  "name": "TutorAgent",
  "version": "0.1.0",
  "description": "AgentCore Runtime Application using Strands TypeScript SDK",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx watch main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1112.0",
    "@aws-sdk/client-s3": "^3.1112.0",
    "@aws-sdk/client-ses": "^3.1111.0",
    "@aws-sdk/lib-dynamodb": "^3.1112.0",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@opentelemetry/api": "^1.9.0",
    "@smithy/node-http-handler": "^4.11.2",
    "@strands-agents/sdk": "^1.5.0",
    "@types/nodemailer": "^8.0.1",
    "bedrock-agentcore": "^0.3.0",
    "mailparser": "^3.9.15",
    "nodemailer": "^9.0.5",
    "puppeteer": "^25.7.0",
    "tsx": "^4.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "bedrock-agentcore": {
      "@strands-agents/sdk": "$@strands-agents/sdk"
    }
  }
}